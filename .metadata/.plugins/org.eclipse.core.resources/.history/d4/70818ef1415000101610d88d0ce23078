#include "exti.h"

#define GPIOCEN			(1U<<2)
#define SYSCFGEN		(1u<<14)

void pc13_exti_init(void)
{
	// (OPTIONAL) Disable global interrupts
	__disable_irq();

	// Enable clock access to GPIO C
	RCC->AHB1ENR |=GPIOCEN;

	// SET PC13 to input
	GPIOC->MODER &=~(1<<26);
	GPIOC->MODER &=~(1<<27);

	// Enable clock access to SYSCFG
	RCC->APB2ENR |=SYSCFGEN;

	// Select PORTC for EXTI13 EXTI = External interrupt
	SYSCFG->EXTICR[3] |=(1<<5);

	// Unmask EXTI13


	// Select falling edge trigger
	// Enable EXTI13 line in NVIC
	// Enable global interrupts
	__enable_irq();
}
